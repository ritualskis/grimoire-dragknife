{
  "name": "grimoire-dragknife",
  "version": "0.1.0",
  "description": "Vectric-accurate G-Code Drag Knife Studio & Post-Processor for Grimoire & Ritual Skis",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cargo": "cargo test --manifest-path crates/grimoire-dragknife/Cargo.toml",
    "test:all": "npm run typecheck && npm run test && npm run test:cargo"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.2.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.11"
  }
}
